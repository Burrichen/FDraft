{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FDraft (Beta)",
  "version": "1.2.0-beta.12",
  "identifier": "com.burrichen.fdraft",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm run build:desktop-frontend"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNTBGMEEzOUY1NjUxMkYKUldRdlVWYWZvL0JRSVBYaVZkZ3RTTHg3VzMwaEhCN1BUb2FVR1pGYVZha2NXSUw1TUJMK0ZKY0cK",
      "endpoints": [
        "https://github.com/Burrichen/FDraft/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FDraft (Beta)",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Burrichen",
    "copyright": "© 2026 Burrichen",
    "category": "Entertainment",
    "shortDescription": "A local-first Letterboxd watchlist and Monthly Watchlist Draft companion.",
    "icon": [
      "icons/beta/32x32.png",
      "icons/beta/128x128.png",
      "icons/beta/128x128@2x.png",
      "icons/beta/icon.icns",
      "icons/beta/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
