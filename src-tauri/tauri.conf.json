{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FDraft",
  "version": "1.0.0",
  "identifier": "com.burrichen.fdraft",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm run build:desktop-frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FDraft",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
