{
  "name": "fdraft",
  "version": "1.2.0-dev.8",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync-desktop-version": "tsx scripts/sync-desktop-version.ts",
    "theme:apply": "tsx scripts/theme-apply.ts",
    "desktop:dev": "pnpm run sync-desktop-version && tauri dev",
    "build:desktop-frontend": "tsx scripts/build-desktop-frontend.ts",
    "desktop:build": "pnpm run sync-desktop-version && tauri build",
    "studio:dev-frontend": "tsx scripts/studio-dev-frontend.ts",
    "build:desktop-frontend:studio": "tsx scripts/build-desktop-frontend.ts --studio",
    "studio:dev": "pnpm run sync-desktop-version && tauri dev --config src-tauri/tauri.studio.conf.json",
    "studio:build": "pnpm run sync-desktop-version && tauri build --config src-tauri/tauri.studio.conf.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@serwist/next": "^9.5.12",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "papaparse": "^5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-moveable": "^0.56.0",
    "serwist": "^9.5.12",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@serwist/cli": "^9.5.12",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
