# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# testing
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# Generated at build time by `serwist build` (see serwist.config.mjs) —
# a fresh copy is produced by every `pnpm build`, and precaches URLs
# specific to that exact build's hashed asset filenames.
/public/sw.js
/public/sw.js.map

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated by the one-off `pnpm dlx supabase gen types ...` migration
# tooling (see .env.example) — already excluded from formatting in
# .prettierignore for the same reason.
/src/lib/supabase/types.generated.ts

# Claude Code local state — machine-specific permission grants and paths
# tied to this user's device; .claude/settings.json (shared project config,
# if ever added) is intentionally NOT covered by this and should stay
# tracked. CLAUDE.md/AGENTS.md are project instructions, also tracked.
.claude/settings.local.json
.claude/*.local.json
